{
  "name": "sentraclass-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:lint": "npm --prefix apps/api run lint",
    "api:type-check": "npm --prefix apps/api run type-check",
    "api:test": "npm --prefix apps/api run test",
    "api:test:db": "npm --prefix apps/api run test:db",
    "api:prisma:generate": "npm --prefix apps/api run prisma:generate",
    "api:prisma:migrate": "npm --prefix apps/api run prisma:migrate",
    "api:prisma:seed": "npm --prefix apps/api run prisma:seed",
    "api:prisma:deploy": "npm --prefix apps/api run prisma:deploy",
    "api:prisma:migrate:test": "npm --prefix apps/api run prisma:migrate:test"
  },
  "dependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "next": "15.1.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.17.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
